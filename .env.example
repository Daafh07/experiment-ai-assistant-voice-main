# Copy this file to ".env" and fill in your own key.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private demo: username is ayla. Generate a strong password with:
# node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# On Vercel, set DEMO_PASSWORD as a server environment variable.
DEMO_PASSWORD=

# Shared audience queue on Vercel. Connect Upstash Redis in Vercel Storage.
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Change for a new presentation; separates its queue and submission token.
AUDIENCE_SESSION=demo

# Optional reachable base URL for audience phones (your domain or tunnel).
# PUBLIC_URL=https://your-domain.example
